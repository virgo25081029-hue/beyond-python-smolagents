  *{box-sizing:border-box}
  body{margin:0;font-family: "Noto Sans", "Segoe UI", sans-serif;background:var(--bg);color:var(--text);-webkit-font-smoothing:antialiased}
  a{color:inherit}

  /* Fixed header so nav always visible */
  header{
    position:fixed;
    top:0;
    left:0;
    right:0;
    height:var(--header-height);
    background:var(--red-pastel);
    color:#fff;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:10px 32px;
    z-index:2000;
    box-shadow:0 2px 8px rgba(0,0,0,0.12);
  }
  .brand{display:flex;align-items:center;gap:12px}
  .brand img{height:48px;width:48px;object-fit:cover;border-radius:8px}
  nav{display:flex;gap:20px;align-items:center}
  nav a{color:white;text-decoration:none;font-weight:600;padding:8px 6px;border-radius:6px}
  nav a:hover{background:rgba(255,255,255,0.06)}

  /* ensure main content starts below header */
  main{padding-top:calc(var(--header-height) + 24px);max-width:1100px;margin:0 auto}

  /* Banner */
  .banner{position:relative;height:68vh;overflow:hidden;border-radius:8px;margin:12px 16px}
  .banner .slide{position:absolute;inset:0;background-position:center;background-size:cover;opacity:0;transition:opacity 1s ease}
  .banner .slide.active{opacity:1}
  .banner .overlay{position:absolute;inset:0;background:rgba(0,0,0,0.45)}
  .banner .content{position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);z-index:3;text-align:center;color:#fff;padding:24px;border-radius:10px}
  .cta{margin-top:16px}
  .btn{background:var(--accent);color:#000;padding:12px 20px;border-radius:999px;text-decoration:none;font-weight:700}

  /* sections */
  section{padding:40px 16px}
  h2{color:var(--red-pastel);margin:0 0 12px;font-size:28px}
  p{line-height:1.7;margin:0 0 12px}

  /* video / gallery / audio */
  .grid{display:grid;gap:18px}
  .videos{grid-template-columns:repeat(auto-fit,minmax(280px,1fr));display:grid}
  .video-card{background:#fff;padding:12px;border-radius:10px;box-shadow:0 8px 20px rgba(0,0,0,0.06)}
  video{width:100%;height:auto;border-radius:8px;background:#000;display:block}

  .gallery{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}
  .gallery img{width:320px;height:200px;object-fit:cover;border-radius:8px;box-shadow:0 6px 14px rgba(0,0,0,0.06)}
  .audio-list{display:flex;gap:12px;flex-wrap:wrap}
  .audio-item{background:#fff;padding:12px;border-radius:10px;box-shadow:0 6px 14px rgba(0,0,0,0.06); width:320px}

  /* QR */
  .qr{display:flex;align-items:center;gap:16px}

  /* footer */
  footer{background:var(--red-pastel);color:#fff;padding:28px 16px;margin-top:20px;text-align:center}

  /* small screens */
  @media (max-width:720px){
    nav{display:none}
    .brand h1{font-size:18px}
    .gallery img{width:100%;height:180px}
  }

  /* make anchor jump account for fixed header */
  section[id] { scroll-margin-top: calc(var(--header-height) + 24px); }

</style>
